{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "janithadf"
		},
		"linkPostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-fancy-hill-b5v78ghn-pooler.c-7.us-east-2.aws.neon.tech"
		},
		"linkPostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"linkPostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"linkkey_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://janithkey.vault.azure.net/"
		},
		"linksa_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://janithac.dfs.core.windows.net/"
		},
		"linksql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "janiths.database.windows.net"
		},
		"linksql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "janithdb"
		},
		"linksql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "janithdb"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "janithadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linkkey_properties_typeProperties_baseUrl": {
						"value": "[parameters('linkkey_properties_typeProperties_baseUrl')]"
					},
					"linksa_properties_typeProperties_url": {
						"value": "[parameters('linksa_properties_typeProperties_url')]"
					},
					"linkPostgreSql_properties_typeProperties_server": {
						"value": "[parameters('linkPostgreSql_properties_typeProperties_server')]"
					},
					"linkPostgreSql_properties_typeProperties_database": {
						"value": "[parameters('linkPostgreSql_properties_typeProperties_database')]"
					},
					"linkPostgreSql_properties_typeProperties_username": {
						"value": "[parameters('linkPostgreSql_properties_typeProperties_username')]"
					},
					"linksql_properties_typeProperties_server": {
						"value": "[parameters('linksql_properties_typeProperties_server')]"
					},
					"linksql_properties_typeProperties_database": {
						"value": "[parameters('linksql_properties_typeProperties_database')]"
					},
					"linksql_properties_typeProperties_userName": {
						"value": "[parameters('linksql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}